{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "frog",
  "main": "src/worker.ts",
  "compatibility_date": "2026-07-01",
  // A path-scoped route rather than a custom domain, which would claim the whole hostname. `wevm.dev`
  // already resolves every subdomain through Cloudflare, so this needs no DNS record of its own.
  "routes": [
    {
      "pattern": "frog.wevm.dev/github",
      "zone_name": "wevm.dev",
    },
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "COORDINATOR",
        "class_name": "WebhookCoordinator",
      },
    ],
  },
  "exports": {
    "WebhookCoordinator": {
      "type": "durable-object",
      "storage": "sqlite",
    },
  },
  "queues": {
    "producers": [
      {
        "binding": "WEBHOOKS",
        "queue": "frog-webhooks",
      },
    ],
    "consumers": [
      {
        "queue": "frog-webhooks",
        "max_batch_size": 10,
        "max_batch_timeout": 1,
        "max_retries": 20,
        "dead_letter_queue": "frog-webhooks-dlq",
        "retry_delay": 30,
      },
    ],
  },
  // Octokit reaches for Node built-ins, and the package layer imports `node:fs` for the offline
  // package lookup the App never takes.
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
  },
}
