{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "frictionsets manifest",
  "type": "object",
  "properties": {
    "docs": {
      "description": "Page explaining what this project wants reported.",
      "type": "string",
      "format": "uri"
    },
    "inbound": {
      "description": "Whether and how this project accepts friction reported by others.",
      "anyOf": [
        {
          "type": "boolean"
        },
        {
          "type": "object",
          "properties": {
            "allowFrom": {
              "description": "Sender repositories, or `owner/*` globs, allowed to report here. Absent means anyone.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "enabled": {
              "default": true,
              "description": "Whether friction reports are accepted at all.",
              "type": "boolean"
            },
            "labels": {
              "description": "Labels applied to inbound issues.",
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      ]
    },
    "labels": {
      "description": "Labels applied to inbound issues.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "name": {
      "description": "Human-readable project name.",
      "type": "string",
      "minLength": 1
    },
    "packages": {
      "description": "npm package names this document speaks for. Used to corroborate the repository claim.",
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "repo": {
      "type": "string",
      "pattern": "^[\\w.-]+\\/[\\w.-]+$",
      "description": "Repository issues are filed on, as `owner/name`."
    },
    "version": {
      "description": "Document format version. Absent is treated as 1.",
      "type": "number",
      "const": 1
    }
  },
  "required": ["repo"]
}
