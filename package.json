{
  "scripts": {
    "build": "zile",
    "changeset:publish": "zile publish:prepare && changeset publish && zile publish:post",
    "changeset:version": "changeset version",
    "check": "vp check --fix",
    "check:docs": "node --import tsx scripts/docs.ts",
    "check:types": "tsc",
    "dev": "zile dev",
    "frictionsets": "node --import tsx src/bin.ts",
    "schema": "node --import tsx scripts/schema.ts",
    "test": "vp test"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@types/node": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "tsx": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:",
    "zile": "catalog:"
  },
  "packageManager": "pnpm@11.15.0",
  "[!start-pkg]": "",
  "name": "frictionsets",
  "type": "module",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Changesets, but for friction logs. Turn friction you hit while building into GitHub issues.",
  "repository": {
    "type": "git",
    "url": "https://github.com/wevm/frictionsets"
  },
  "keywords": [
    "agents",
    "changesets",
    "dx",
    "friction-log",
    "github-issues"
  ],
  "bin": {
    "frictionsets": "./dist/bin.js",
    "frictionsets.src": "./src/bin.ts"
  },
  "files": [
    "dist",
    "src",
    "SKILL.md",
    "schema.json",
    "manifest.schema.json"
  ],
  "exports": {
    ".": {
      "src": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "dependencies": {
    "@clack/prompts": "catalog:",
    "@octokit/rest": "catalog:",
    "human-id": "catalog:",
    "incur": "catalog:",
    "yaml": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
